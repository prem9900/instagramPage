pipeline {
    agent any  // Run this pipeline on any available machine (agent)

    environment {
        NODE_ENV = 'production'  // Set an environment variable to indicate production mode
    }

    stages {
        stage('Clone Repository') {
            steps {
                echo 'Cloning the repository...'  // Just a message for logs
                checkout scm  // Jenkins will automatically pull the code from your GitHub repo
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing node modules...'  // Show this message in the Jenkins console
                sh 'npm install'  // Run the npm install command to download all required packages
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building the application...'  // Message for the build stage
                sh 'npm run build'  // Build the app (create optimized production files)
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the application...'  // Message before deploy step
                // Replace the line below with your actual deployment steps
                sh 'echo "Deployment step (like copying build folder to server)"'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'  // Show this if everything runs fine
        }
        failure {
            echo 'Pipeline failed. Please check the error logs.'  // Show this if any step fails
        }
    }
}

